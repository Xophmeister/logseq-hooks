#!/usr/bin/env bb

;;; post-commit: pushes when enough work has accumulated, or when the remote
;;; has gone stale. Thresholds are derived from recent history rather than
;;; hard-coded and cached in .git/ so the common path stays cheap.
;;;
;;; Also clears the deferral marker set by prepare-commit-msg: a commit has now
;;; happened, so nothing is being held back any more.

(require '[babashka.classpath :refer [add-classpath]]
         '[babashka.fs :as fs])

(add-classpath (str (fs/path (fs/parent (fs/absolutize *file*)) "src")))

(require '[babashka.process :as p]
         '[clojure.string :as str]
         '[logseq-hooks.churn :as churn]
         '[logseq-hooks.config :as config]
         '[logseq-hooks.git :as git]
         '[logseq-hooks.policy :as policy]
         '[logseq-hooks.state :as state])

(def cache-filename "push-thresholds.edn")
(def pending-marker "logseq-deferred-commit")

(defn remote-ref []
  (format "refs/remotes/%s/%s" (config/value :push :remote) (config/value :push :branch)))

;;; ------------------------------------------------------------ git plumbing

(defn churn-exclusions []
  (into churn/churn-exclusions (churn/exclude (config/value :excluded-paths))))

(defn file-exclusions []
  (into churn/backup-exclusions (churn/exclude (config/value :excluded-paths))))

(defn remote-age
  "Seconds since the commit at the remote ref, or nil if the ref doesn't exist."
  []
  (when-let [ts (git/git "log" "-1" "--format=%ct" (remote-ref))]
    (- (git/epoch-now) (parse-long ts))))

(defn unpushed-stats
  "Totals for everything on HEAD that isn't on the remote."
  []
  (->> (apply git/git! "diff" "--numstat" (str (remote-ref) "..HEAD")
              "--" (churn/pathspec (churn-exclusions)))
       str/split-lines
       churn/parse-numstat
       churn/totals))

;;; --------------------------------------------------------------- statistics

(defn percentile
  "Nearest-rank percentile of `xs`, where `pct` is 0-100. nil for an empty `xs`."
  [pct xs]
  (when (seq xs)
    (let [sorted (vec (sort xs))
          idx (-> (* (/ pct 100.0) (count sorted))
                  Math/ceil
                  int
                  (max 1)
                  dec)]
      (sorted idx))))

(defn- parse-log-block
  "A block is `<hash> <timestamp>` followed by numstat lines."
  [block]
  (let [[header & stat-lines] (str/split-lines block)
        [hash ts] (str/split header #" ")]
    (assoc (churn/totals (churn/parse-numstat stat-lines))
           :hash hash
           :ts (parse-long ts))))

(defn sample-commits
  "Per-commit {:hash :ts :churn :files} for recent history, ignoring paths
   matched by `exclusions`."
  [exclusions]
  ;; The NUL prefix delimits commit blocks: numstat output is otherwise
  ;; indistinguishable from commit metadata once the two are interleaved.
  (let [log (apply git/git! "log"
                   (str "--max-count=" (config/value :push :sample-size))
                   "--no-merges"
                   "--numstat"
                   "--format=%x00%H %ct"
                   "--" (churn/pathspec exclusions))]
    (->> (str/split log #"\x00")
         (remove str/blank?)
         (map parse-log-block))))

(defn window-buckets
  "Sums commits into fixed-width time windows anchored at the newest commit.
   Empty windows are dropped; we only ever test when there is unpushed work.

   Bucketing matters because the thresholds are compared against *accumulated*
   unpushed churn, not against a single commit's worth."
  [window-secs commits]
  (when (seq commits)
    (let [newest (apply max (map :ts commits))]
      (->> commits
           (group-by #(quot (- newest (:ts %)) window-secs))
           vals
           (map #(hash-map :churn (transduce (map :churn) + %)
                           :files (transduce (map :files) + %)))))))

(defn- p90-or-floor
  "p90 of `k` across `buckets`, floored at `floor`. Falls back to `floor` alone
   until there's enough history for a percentile to mean anything."
  [floor k buckets]
  (if (>= (count buckets) (config/value :push :min-buckets))
    (max floor (percentile 90 (map k buckets)))
    floor))

(defn compute-thresholds []
  (let [window (config/value :push :min-interval)
        churn-buckets (window-buckets window (sample-commits (churn-exclusions)))
        file-buckets (window-buckets window (sample-commits (file-exclusions)))]
    {:churn (p90-or-floor (config/value :push :churn-floor) :churn churn-buckets)
     :files (p90-or-floor (config/value :push :file-floor) :files file-buckets)
     ;; Diagnostic only: sample size behind the numbers above. Inspect the
     ;; cache file by hand if a threshold looks wrong.
     :n (count churn-buckets)
     :sampled (git/epoch-now)}))

(defn thresholds []
  (state/cached cache-filename (config/value :push :cache-ttl) compute-thresholds))

;;; ------------------------------------------------------------------ decision

(defn current-state []
  (let [age (remote-age)]
    (merge {:remote-age age
            :up-to-date? (and age (= (git/git! "rev-parse" "HEAD")
                                     (git/git! "rev-parse" (remote-ref))))}
           (if age (unpushed-stats) {:churn 0 :files 0}))))

;;; --------------------------------------------------------------- entry point

(defn push! []
  ;; git ignores this hook's exit status, so a failed push must not surface as
  ;; an unhandled exception: Logseq would show the stack trace as an error.
  (let [{:keys [exit err]} (p/sh ["git" "push" "--quiet"
                                  (config/value :push :remote)
                                  (config/value :push :branch)])]
    (when-not (zero? exit)
      (println "push failed, will retry after the next commit:" (str/trim (str err))))))

(defn -main []
  ;; A commit exists, so nothing is being held back any more.
  (state/unmark! pending-marker)
  (let [[action reason] (policy/push-decision (current-state) (thresholds) (:push @config/config))]
    (case action
      :push (do (println "pushing:" reason) (push!))
      :skip (println "skipping push:" reason))))

(-main)
(System/exit 0)

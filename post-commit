#!/usr/bin/env bb

(require '[babashka.process :as p]
         '[clojure.string :as str]
         '[clojure.edn :as edn]
         '[babashka.fs :as fs])

(def min-interval (* 60 60))   ; 1 hour
(def max-interval (* 3 60 60)) ; 3 hours

(def churn-floor 150)
(def file-floor  15)
(def min-buckets 20)
(def sample-size 400)

(def remote-ref "refs/remotes/origin/main")

(def ^:private backup-exclusions
  [":(exclude)logseq/bak/**"
   ":(exclude)logseq/.recycle/**"])

(def churn-exclusions (conj backup-exclusions ":(exclude)assets/**"))
(def file-exclusions  backup-exclusions)

(defn git
  "Runs git with `args`, returning trimmed stdout, or nill if git exited non-zero."
  [& args]
  (let [{:keys [out exit]} (p/sh (into ["git"] args))]
    (when (zero? exit)
      (str/trim out))))

(defn git!
  "Like `git`, but throws if the command fails."
  [& args]
  (-> (p/sh (into ["git"] args))
      p/check
      :out
      str/trim))

(defn epoch-now [] (.getEpochSecond (java.time.Instant/now)))

(defn remote-age
  "Seconds since the commit at `remote-ref`, or nil if the ref doesn't exist."
  []
  (when-let [ts (git "log" "-1" "--format=%ct" remote-ref)]
    (- (epoch-now) (parse-long ts))))

(defn percentile
  "Nearest-rank percentile of `xs`. p is 0-100."
  [p xs]
  (when (seq xs)
    (let [sorted (vec (sort xs))
          idx    (-> (* (/ p 100.0) (count sorted))
                     Math/ceil
                     int
                     (max 1)
                     dec)]
      (sorted idx))))

(defn- count-or-zero
  "--numstate reports `-` for binary files."
  [s]
  (if (= "-" s) 0 (parse-long s)))

(defn numstat-totals
  "Sums `added\tdeleted\tpath` lines into {:churn n :files n}.
   Binary files contribute a file but no churn."
  [lines]
  (reduce (fn [acc line]
            (let [[added deleted] (str/split line #"\t")]
              (-> acc
                  (update :files inc)
                  (update :churn + (count-or-zero added) (count-or-zero deleted)))))
          {:churn 0 :files 0}
          lines))

(defn unpushed-stats []
  (->> (git! "diff" "--numstat" (str remote-ref "..HEAD"))
       str/split-lines
       (remove str/blank?)
       numstat-totals))

(defn- parse-log-block
  "A block is `<hash> <timestamp>` followed by numstat lines."
  [block]
  (let [[header & stat-lines] (str/split-lines block)
        [hash ts]             (str/split header #" ")]
    (assoc (numstat-totals (remove str/blank? stat-lines))
           :hash hash
           :ts   (parse-long ts))))

(defn sample-commits
  "Per-commit {:hash :ts :churn :files} for recent history, excluding `pathspec`."
  [exclusions]
  (->> (apply git!
              "log"
              (str "--max-count=" sample-size)
              "--no-merges"
              "--numstat"
              "--format=%x00%H %ct"
              "--"
              exclusions)
       (#(str/split % #"\x00"))
       (remove str/blank?)
       (map parse-log-block)))

(defn window-buckets
  "Sums commits into fixed-width time windows anchored at the newest commit.
   Windows containing no commits are dropped; we only ever test when there is unpushed work."
  [window-secs commits]
  (when (seq commits)
    (let [newest (apply max (map :ts commits))]
      (->> commits
           (group-by #(quot (- newest (:ts %)) window-secs))
           vals
           (map #(hash-map :churn (transduce (map :churn) + %)
                           :files (transduce (map :files) + %)))))))

(defn compute-thresholds []
  (let [churn-buckets (window-buckets min-interval (sample-commits churn-exclusions))
        file-buckets  (window-buckets min-interval (sample-commits file-exclusions))]
    {:churn   (max churn-floor (or (percentile 90 (map :churn churn-buckets)) 0))
     :files   (max file-floor  (or (percentile 90 (map :files file-buckets)) 0))
     :n       (count churn-buckets)
     :sampled (epoch-now)}))

(def cache-ttl (* 24 60 60))
(def cache-file (fs/file (git! "rev-parse" "--absolute-git-dir") "push-thresholds.edn"))

(defn- fresh-cache []
  (when (fs/exists? cache-file)
    (let [age (- (epoch-now) (.getEpochSecond (fs/last-modified-time cache-file)))]
      (when (< age cache-ttl)
        (try
          (edn/read-string (slurp cache-file))
          (catch Exception _ nil))))))   ; corrupt or truncated; recompute

(defn thresholds []
  (or (fresh-cache)
      (let [t (compute-thresholds)]
        (spit cache-file (pr-str t))
        t)))

(defn should-push?
  [{:keys [remote-age up-to-date? churn files]} thresholds]
  (cond
    (nil? remote-age)               [:push "no remote tracking ref"]
    up-to-date?                     [:skip "already up to date"]
    (>= remote-age max-interval)    [:push "remote is stale"]
    (< remote-age min-interval)     [:skip "pushed too recently"]
    (>= churn (:churn thresholds))  [:push (format "%d lines (p90 %d)" churn (:churn thresholds))]
    (>= files (:files thresholds))  [:push (format "%d files (p90 %d)" files (:files thresholds))]
    :else                           [:skip "below thresholds"]))

(defn current-state []
  (let [age (remote-age)]
    (merge {:remote-age  age
            :up-to-date? (and age (= (git! "rev-parse" "HEAD")
                                     (git! "rev-parse" remote-ref)))}
           (if age (unpushed-stats) {:churn 0 :files 0}))))

(let [[action reason] (should-push? (current-state) (thresholds))]
  (cond
    (= :push action) (do
      (println "pushing:" reason)
      (p/shell "git" "push" "--quiet" "origin" "main"))

    (= :skip action)
      (println "skipping push:" reason)))

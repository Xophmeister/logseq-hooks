#!/usr/bin/env bash

# Wires these hooks into the Logseq graph repository this repo is a submodule
# of. Idempotent: safe to re-run after updating the submodule pointer.

set -euo pipefail

usage() {
    cat <<EOF
usage: bin/install [--hooks-path <dir>]

  --hooks-path <dir>  Point core.hooksPath at <dir> rather than at this repo.

                      git runs exactly one hooks directory, so a graph that
                      wants a hook of its own cannot simply add one here.
                      Instead it owns <dir> -- holding its own hooks, plus
                      thin wrappers that hand over to the scripts in this
                      repo -- and this flag stops a re-run of the installer
                      from taking that directory back.

                      Relative to the graph root, or absolute.
EOF
}

hooks_path_override=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --hooks-path)
            if [[ $# -lt 2 ]]; then
                echo "error: --hooks-path needs a directory" >&2
                exit 1
            fi
            hooks_path_override="$2"
            shift 2
            ;;
        --hooks-path=*)
            hooks_path_override="${1#*=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

hooks_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

graph_dir="$(git -C "$hooks_dir" rev-parse --show-superproject-working-tree)"
if [[ -z "$graph_dir" ]]; then
    cat >&2 <<EOF
error: this repository is not a submodule of anything.

Add it to your graph repository first, then run this script from there:

    git submodule add <url> .hooks
    .hooks/bin/install
EOF
    exit 1
fi

git_dir="$(git -C "$graph_dir" rev-parse --absolute-git-dir)"
# core.hooksPath is resolved relative to the top of the working tree, so it has
# to be stored that way rather than as the absolute path we happen to have.
rel_hooks="$(realpath --relative-to="$graph_dir" "$hooks_dir")"
config_file="$git_dir/logseq-hooks.edn"

# Where git is told to look, which is this repo unless the graph has claimed
# that job for itself.
if [[ -n "$hooks_path_override" ]]; then
    case "$hooks_path_override" in
        /*) override_dir="$hooks_path_override" ;;
        *)  override_dir="$graph_dir/$hooks_path_override" ;;
    esac
    if [[ ! -d "$override_dir" ]]; then
        echo "error: --hooks-path $hooks_path_override is not a directory" >&2
        exit 1
    fi
    hooks_path="$(realpath --relative-to="$graph_dir" "$override_dir")"
    if [[ "$hooks_path" == ".." || "$hooks_path" == ../* ]]; then
        echo "error: --hooks-path must be inside the graph at $graph_dir" >&2
        exit 1
    fi
else
    hooks_path="$rel_hooks"
fi

chmod +x "$hooks_dir/prepare-commit-msg" "$hooks_dir/post-commit"
git -C "$graph_dir" config core.hooksPath "$hooks_path"
echo "core.hooksPath set to $hooks_path"

# Handing the directory over means the graph owns the files git actually runs,
# so the scripts here are reached only if something there delegates to them.
# Nothing can verify that it does; the least we can do is notice the files are
# missing entirely, rather than leave these hooks silently dead.
if [[ "$hooks_path" != "$rel_hooks" ]]; then
    for hook in prepare-commit-msg post-commit; do
        if [[ ! -e "$graph_dir/$hooks_path/$hook" ]]; then
            echo "warning: no $hook in $hooks_path, so that hook will not run" >&2
            echo "         until something there hands over to $rel_hooks/$hook" >&2
        fi
    done
fi

# The config lives in the git directory rather than the working tree because it
# holds an API key: git does not track it and Logseq does not sync it. The
# corollary is that it does not survive a fresh clone, hence this script.
example="$hooks_dir/logseq-hooks.example.edn"
placeholder="@EXCLUDED_PATHS@"

# Neither this repo nor the directory git runs hooks from holds notes, so both
# want excluding -- unless one contains the other, when the outer one already
# covers it and naming both would only be noise.
excluded=("$hooks_path")
if [[ "$rel_hooks" != "$hooks_path" && "$rel_hooks" != "$hooks_path"/* ]]; then
    excluded+=("$rel_hooks")
fi

if [[ -e "$config_file" ]]; then
    echo "config already present at $config_file, left alone"
    # Only a freshly seeded config gets these paths written into it, and the
    # library no longer guesses any. So an older config, or one written before
    # things were moved around, would quietly count pointer bumps as notes.
    # Grepping the text is crude, but this only offers advice.
    for path in "${excluded[@]}"; do
        if ! grep -qF "\"$path\"" "$config_file"; then
            echo "note: $config_file does not mention $path; add it to" \
                 ":excluded-paths or changes there count towards churn"
        fi
    done
else
    if ! grep -qF "$placeholder" "$example"; then
        echo "error: $placeholder is missing from $example, so the mount" >&2
        echo "       point cannot be seeded; the two have drifted apart" >&2
        exit 1
    fi
    excluded_edn=""
    for path in "${excluded[@]}"; do
        excluded_edn+="${excluded_edn:+ }\"$path\""
    done

    # Created empty and private first: the redirection below leaves the mode
    # alone, so the file is never briefly readable by anyone else.
    install -m 600 /dev/null "$config_file"
    awk -v paths="$excluded_edn" -v ph="$placeholder" '{ gsub(ph, paths); print }' \
        "$example" > "$config_file"
    echo "config created at $config_file; add your API key to it"
fi

if ! command -v bb >/dev/null 2>&1; then
    echo "warning: bb is not on this PATH; the hooks will not run without it" >&2
    echo "         check the PATH Logseq itself is started with, not just yours" >&2
fi

# Logseq writes a backup of every file it touches. Left tracked, these dominate
# every diff and distort both churn measures.
gitignore="$graph_dir/.gitignore"
for pattern in "logseq/bak/" "logseq/.recycle/"; do
    if ! grep -qxF "$pattern" "$gitignore" 2>/dev/null; then
        echo "suggestion: add '$pattern' to $gitignore"
    fi
done
